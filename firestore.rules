rules_version = '2';

// Friends, rooms, invites and online matches. See docs/friends.md.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Profiles are readable by any player (to find a friend by code and show
    // presence); only the owner can write theirs.
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if request.auth.uid == uid;

      // A friendship is stored on both sides; either friend may create or
      // delete either side. Others may see the list only if its owner shares it.
      match /friends/{friendId} {
        allow read: if request.auth.uid == uid
          || (signedIn() && get(/databases/$(database)/documents/users/$(uid)).data
                .get('privacy', {}).get('showFriends', false) == true);
        allow write: if request.auth.uid == uid || request.auth.uid == friendId;
      }
    }

    // Rooms are readable by any player so one can be found by its code. The
    // host may change anything; anyone else may only take or give up a seat
    // (players and names) while the room is open.
    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.host == request.auth.uid
        && request.resource.data.players == [request.auth.uid];
      allow update: if signedIn() && (resource.data.host == request.auth.uid
        || (resource.data.status == 'open'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'names'])));
    }

    match /invites/{inviteId} {
      allow read, update: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      // Players who turned invites off get none.
      allow create: if signedIn() && request.resource.data.from == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.resource.data.to)).data
             .get('privacy', {}).get('allowInvites', true) != false;
    }

    match /matches/{matchId} {
      allow read, update: if signedIn() && request.auth.uid in resource.data.players;
      allow create: if signedIn() && request.auth.uid in request.resource.data.players;
    }
  }
}
